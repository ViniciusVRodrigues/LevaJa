{
  "name": "micro-mongo",
  "version": "1.0.0",
  "description": "Microserviço de lotes de produtos com MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest tests/ || echo 'Jest não instalado. Execute: npm install --save-dev jest'",
    "test:arch": "jest tests/architecture.test.js || echo 'Jest não instalado. Execute: npm install --save-dev jest'",
    "docker-build": "docker build -t viniciusvr/micro-mongo:latest .",
    "docker-push": "docker push viniciusvr/micro-mongo:latest",
    "docker-run": "docker run -d -p 5000:5000 --name micro-mongo viniciusvr/micro-mongo:latest"
  },
  "keywords": ["microservice", "mongodb", "products"],
  "author": "Equipe de Desenvolvimento",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "mongoose": "^8.0.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
