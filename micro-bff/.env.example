# Configurações do Servidor
PORT=3000
NODE_ENV=development

# URLs dos Microsserviços
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002

# Configurações de CORS
# Use '*' apenas para desenvolvimento. Em produção, especifique os domínios permitidos
# Exemplo: CORS_ORIGIN=https://exemplo.com,https://app.exemplo.com
CORS_ORIGIN=http://localhost:4200

# Configurações de Timeout (em milissegundos)
REQUEST_TIMEOUT=5000

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Configurações do Azure Functions
# URLs das Azure Functions (HTTP Trigger)
AZURE_FUNCTION1_URL=https://your-function-app.azurewebsites.net/api/function1
AZURE_FUNCTION2_URL=https://your-function-app.azurewebsites.net/api/function2

# Chaves de autenticação das Functions (opcional, se usar function keys)
AZURE_FUNCTION1_KEY=your-function1-key
AZURE_FUNCTION2_KEY=your-function2-key

# Timeout para chamadas às Azure Functions (em milissegundos)
AZURE_FUNCTION_TIMEOUT=10000

# Configurações do Azure Service Bus
# Connection String do Service Bus Namespace
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key

# Nomes das filas (queues) do Service Bus
# O BFF publica eventos em 2 filas diferentes:
# - usuario-criado: para eventos de criação de usuários
# - lote-criado: para eventos de criação de lotes de produtos
# Certifique-se de criar ambas as filas no Azure Service Bus antes de iniciar o BFF
AZURE_SERVICE_BUS_USER_QUEUE=usuario-criado
AZURE_SERVICE_BUS_PRODUCT_QUEUE=lote-criado

# Fila padrão (opcional, para outras operações genéricas)
AZURE_SERVICE_BUS_QUEUE_NAME=default-queue
