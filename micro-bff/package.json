{
  "name": "micro-bff",
  "version": "1.0.0",
  "description": "Backend for Frontend API Gateway para gestão de usuários e produtos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest tests/ || echo 'Jest não instalado. Execute: npm install --save-dev jest'",
    "test:arch": "jest tests/architecture.test.js || echo 'Jest não instalado. Execute: npm install --save-dev jest'",
    "docker-build": "docker build -t viniciusvr/micro-bff:latest .",
    "docker-push": "docker push viniciusvr/micro-bff:latest",
    "docker-run": "docker run -d -p 3000:3000 --name micro-bff viniciusvr/micro-bff:latest"
  },
  "keywords": [
    "bff",
    "api-gateway",
    "express",
    "microservices"
  ],
  "author": "Equipe de Desenvolvimento",
  "license": "ISC",
  "dependencies": {
    "@azure/service-bus": "^7.9.5",
    "axios": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
